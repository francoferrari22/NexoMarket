<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=edge" />
<meta charset="utf-8" />
<title>NexoMarket · Super Admin 5.15</title>
<HTA:APPLICATION ID="NexoMarketSuperAdmin" APPLICATIONNAME="NexoMarket Super Admin" BORDER="thin" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="maximized" />
<style>
*{box-sizing:border-box}html,body{margin:0;padding:0;background:#05070a;color:#fff;font-family:'Segoe UI',Arial,sans-serif}body{overflow:auto}.top{height:76px;background:linear-gradient(90deg,#05070a,#0a0f15);border-bottom:1px solid #243444;display:flex;align-items:center;padding:0 24px;gap:16px}.logo{font-size:25px;font-weight:950;letter-spacing:-1px}.logo b{color:#39ff66}.sub{color:#8fa4b7;font-size:10px;font-weight:900;letter-spacing:1.3px}.spacer{flex:1}.btn{border:1px solid #2b3e50;background:#0c141c;color:#fff;border-radius:10px;padding:9px 13px;font-weight:900;cursor:pointer}.btn:hover{border-color:#fff;box-shadow:0 0 15px rgba(255,255,255,.08)}.btn.green{background:#39ff66;color:#041008;border-color:#39ff66}.btn.yellow{background:#d7a51d;color:#100d03;border-color:#ffd84d}.btn.red{background:#3c1018;color:#ff9baa;border-color:#8d2636}.btn.violet{background:linear-gradient(135deg,#6f35d9,#a96cff);color:#fff;border-color:#39ff66;box-shadow:0 0 14px rgba(167,103,255,.42),0 0 22px rgba(57,255,102,.14)}.btn.plus{background:linear-gradient(135deg,#5f24b9,#9b5cff);color:#fff;border-color:#39ff66;box-shadow:0 0 14px rgba(167,103,255,.55),0 0 28px rgba(57,255,102,.18)}.layout{display:flex;min-height:calc(100vh - 76px)}.side{width:235px;background:#080c11;border-right:1px solid #1b2a37;padding:16px}.nav{display:block;width:100%;text-align:left;margin-bottom:7px}.nav.active{border-color:#39ff66;background:linear-gradient(90deg,rgba(57,255,102,.09),rgba(167,103,255,.08));box-shadow:0 0 16px rgba(57,255,102,.08)}.main{flex:1;padding:20px;overflow:auto}.hero{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:20px;border:1px solid #253746;border-radius:20px;background:linear-gradient(135deg,#09131b,#0b0c14);box-shadow:0 18px 50px rgba(0,0,0,.25)}h1,h2,h3{margin-top:0}.muted{color:#91a4b5}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:15px 0}.kpi{background:#090d12;border:1px solid #1d2c39;border-radius:14px;padding:13px}.kpi small{display:block;color:#75899b;font-size:9px;font-weight:800}.kpi strong{display:block;font-size:23px;margin-top:5px}.workspace{display:grid;grid-template-columns:minmax(420px,1fr) 430px;gap:15px}.card{background:linear-gradient(145deg,#090d12,#0b1016);border:1px solid #1e2e3c;border-radius:17px;padding:15px}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.toolbar input,.toolbar select,.field{background:#0c141c;color:#fff;border:1px solid #294052;border-radius:10px;padding:10px}.toolbar input{min-width:260px}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:9px;border-bottom:1px solid #172631;font-size:11px}.table th{color:#39ff66;font-size:9px;letter-spacing:.8px;position:sticky;top:0;background:#090d12}.table tr:hover td{background:rgba(255,255,255,.025)}.store-row{cursor:pointer}.store-row.selected td{background:rgba(57,255,102,.06)}.tag{display:inline-block;font-size:8px;border-radius:999px;padding:4px 7px;border:1px solid #334858;color:#a9bac7;margin:1px}.tag.green{border-color:#2b8b4a;color:#7cff9a}.tag.yellow{border-color:#9b7c27;color:#ffd84d}.tag.red{border-color:#8b2e3e;color:#ff8c9c}.tag.violet{border-color:#7547a6;color:#cba5ff}.tag.plus{border-color:#39ff66;color:#e0c7ff;background:rgba(113,45,180,.22);box-shadow:0 0 10px rgba(167,103,255,.35)}.detail{position:sticky;top:10px;align-self:start}.detail-head{display:flex;gap:12px;align-items:center}.thumb{width:74px;height:74px;border-radius:15px;background:#111821;border:1px solid #2a4052;display:flex;align-items:center;justify-content:center;overflow:hidden;color:#39ff66;font-weight:900;font-size:24px;flex:none}.thumb img{width:100%;height:100%;object-fit:cover}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.detail-grid div{background:#0d141c;border:1px solid rgba(255,255,255,.07);border-radius:11px;padding:9px}.detail-grid small{display:block;color:#7d91a2;font-size:8px;text-transform:uppercase;letter-spacing:.6px}.detail-grid strong{display:block;margin-top:4px;font-size:11px;word-break:break-word}.section-title{margin:18px 0 8px;color:#d8e4ec;font-size:10px;letter-spacing:1.1px;font-weight:950}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.action-grid .btn{width:100%;font-size:10px}.commission-box{margin-top:12px;padding:13px;border-radius:14px;border:1px solid rgba(212,175,55,.42);background:linear-gradient(145deg,#151108,#0b0e12)}.commission-percent{font-size:27px;font-weight:950;color:#ffd84d}.commission-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.commission-row div{background:#0e141a;border-radius:9px;padding:8px}.commission-row small{display:block;color:#948b73;font-size:8px}.commission-row strong{display:block;margin-top:4px}.empty{padding:35px;text-align:center;color:#8193a2;border:1px dashed #314654;border-radius:15px}.notice{margin-top:10px;color:#9fb1bf;font-size:10px;line-height:1.5}.context{display:none;position:fixed;z-index:10000;min-width:230px;background:#0a0e13;border:1px solid #42586a;border-radius:12px;box-shadow:0 18px 50px rgba(0,0,0,.65);padding:6px}.context button{display:block;width:100%;text-align:left;background:none;border:0;color:#fff;padding:9px 10px;border-radius:8px;font-weight:800;cursor:pointer}.context button:hover{background:rgba(57,255,102,.09)}.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.76);align-items:center;justify-content:center;z-index:20000}.modal.open{display:flex}.modal-box{width:500px;max-width:94vw;background:#090d12;border:1px solid #3a5264;border-radius:18px;padding:20px;box-shadow:0 20px 70px rgba(0,0,0,.65)}.modal-box input{width:100%;margin:6px 0;background:#0c141c;color:#fff;border:1px solid #294052;border-radius:9px;padding:11px}.tabs{display:flex;gap:7px;margin-bottom:12px}.tab{flex:1}.tab.active{border-color:#39ff66;background:rgba(57,255,102,.08)}.account-table{max-height:65vh;overflow:auto}@media(max-width:1100px){.workspace{grid-template-columns:1fr}.detail{position:relative}.kpis{grid-template-columns:repeat(2,1fr)}}
</style>
<script>
var BASE='https://nexomarket-0k22.onrender.com',stores=[],accounts=[],commissions=[],selectedId='',view='stores';
function req(path,method,data,cb){var x=null;try{x=new ActiveXObject('MSXML2.XMLHTTP.6.0')}catch(e){try{x=new ActiveXObject('Microsoft.XMLHTTP')}catch(e2){cb('',e2);return}}x.open(method||'GET',BASE+path,true);x.setRequestHeader('Content-Type','application/x-www-form-urlencoded; charset=UTF-8');x.onreadystatechange=function(){if(x.readyState===4)cb(x.responseText||'',null)};x.send(enc(data||{}))}
function enc(o){var a=[];for(var k in o)if(o.hasOwnProperty(k))a.push(encodeURIComponent(k)+'='+encodeURIComponent(o[k]==null?'':o[k]));return a.join('&')}
function json(t,d){try{return JSON.parse(t)}catch(e){return d}}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
function val(a,k){for(var i=0;i<a.length;i++){var p=a[i].split('=');if(p[0]===k)return p.slice(1).join('=')}return '0'}
function parseStores(t){stores=[];var ls=(t||'').split(/\r?\n/);for(var i=0;i<ls.length;i++){if(ls[i].indexOf('STORE|')!==0)continue;var r=ls[i].split('|'),p=[];for(var j=0;j<r.length;j++){try{p.push(decodeURIComponent(r[j]))}catch(e){p.push(r[j])}}if(p.length>=13)stores.push({id:p[1],name:p[2],category:p[3],city:p[4],province:p[5],active:p[6]==='1',email:p[7],updated:p[8],logo:p[9],featured:p[10]==='1',listed:p[11]==='1',system:p[12],featuredPlus:p[13]==='1'})}}
function parseAccounts(t){accounts=[];var ls=(t||'').split(/\r?\n/);for(var i=0;i<ls.length;i++){if(ls[i].indexOf('ACCOUNT|')!==0)continue;var r=ls[i].split('|'),p=[];for(var j=0;j<r.length;j++){try{p.push(decodeURIComponent(r[j]))}catch(e){p.push(r[j])}}if(p.length>=9)accounts.push({id:p[1],name:p[2],email:p[3],role:p[4],storeId:p[5],active:p[6]!=='0',trial:p[7],created:p[8]})}}
function refresh(){document.getElementById('status').innerHTML='● ACTUALIZANDO';req('/api/admin/overview','GET',{},function(o){req('/api/admin/stores','GET',{},function(st){req('/api/admin/accounts','GET',{},function(ac){req('/api/admin/commissions','GET',{},function(co){parseStores(st);parseAccounts(ac);commissions=json(co,[])||[];var p=o.split('|');document.getElementById('statStores').innerHTML=val(p,'stores');document.getElementById('statAccounts').innerHTML=val(p,'accounts');document.getElementById('statActive').innerHTML=val(p,'activeStores');var due=0;for(var i=0;i<commissions.length;i++)if(!commissions[i].paid)due+=Number(commissions[i].due||0);document.getElementById('statDue').innerHTML='$ '+due.toFixed(2);document.getElementById('status').innerHTML='● CENTRAL · '+new Date().toLocaleTimeString();renderStores();renderAccounts();if(selectedId)loadDetail(selectedId);});});});})}
function renderStores(){var q=(document.getElementById('storeSearch')||{}).value||'',h='<table class="table"><tr><th>TIENDA</th><th>VENDEDOR</th><th>ESTADO</th><th>PUBLICACIÓN</th><th>COMISIÓN</th></tr>';q=q.toLowerCase();var n=0;for(var i=0;i<stores.length;i++){var s=stores[i],hay=(s.name+' '+s.email+' '+s.city+' '+s.category).toLowerCase();if(q&&hay.indexOf(q)<0)continue;var c=findCommission(s.id);h+='<tr class="store-row '+(selectedId===s.id?'selected':'')+'" data-id="'+esc(s.id)+'" ondblclick="loadDetail(\''+esc(s.id)+'\')" oncontextmenu="showMenu(event,\''+esc(s.id)+'\');return false" onclick="selectStore(\''+esc(s.id)+'\')"><td><b>'+esc(s.name)+'</b><br><small class="muted">'+esc(s.category)+' · '+esc(s.city)+'</small></td><td>'+esc(s.email||'Sin vendedor')+'</td><td><span class="tag '+(s.active?'green':'red')+'">'+(s.active?'ABIERTA / ACTIVA':'CERRADA / BLOQUEADA')+'</span></td><td><span class="tag '+(s.listed?'green':'red')+'">'+(s.listed?'VISIBLE':'OCULTA')+'</span> '+(s.featured?'<span class="tag green">★ DESTACADA</span>':'')+(s.featuredPlus?'<span class="tag plus">✦ PLUS</span>':'')+'</td><td><span class="tag yellow">'+Number(c.percent||1).toFixed(2)+'%</span></td></tr>';n++}h+='</table>';document.getElementById('storeTable').innerHTML=n?h:'<div class="empty">No se encontraron tiendas.</div>';document.getElementById('storeCount').innerHTML=n+' tiendas visibles'}
function findCommission(id){for(var i=0;i<commissions.length;i++)if(String(commissions[i].storeId)===String(id))return commissions[i];return {percent:1,sales:0,due:0,paid:false,dueDate:''}}
function selectStore(id){selectedId=id;renderStores();loadDetail(id)}
function loadDetail(id){selectedId=id;document.getElementById('detail').innerHTML='<div class="empty">Cargando información completa…</div>';req('/api/admin/store/details?storeId='+encodeURIComponent(id),'GET',{},function(t){var d=json(t,null);if(!d||d.error){document.getElementById('detail').innerHTML='<div class="empty">No se pudo cargar la tienda.</div>';return}var c=d.commission||findCommission(id);var logo=d.Logo?'<img src="'+esc(d.Logo)+'">':'N';var active=d.Active!=='0',listed=d.Listed!=='0',featured=d.Featured==='1',featuredPlus=d.FeaturedPlus==='1';document.getElementById('detail').innerHTML='<div class="detail-head"><div class="thumb">'+logo+'</div><div><div class="sub">FICHA DE TIENDA</div><h2>'+esc(d.Name||'Sin nombre')+'</h2><div class="muted">'+esc(d.Category)+' · '+esc(d.City)+', '+esc(d.Province)+'</div></div></div><div class="tags"><span class="tag '+(active?'green':'red')+'">'+(active?'ABIERTA / ACTIVA':'CERRADA / BLOQUEADA')+'</span><span class="tag '+(listed?'green':'red')+'">'+(listed?'PUBLICADA':'OCULTA')+'</span><span class="tag '+(featured?'green':'')+'">'+(featured?'★ DESTACADA':'NORMAL')+'</span><span class="tag '+(featuredPlus?'plus':'')+'">'+(featuredPlus?'✦ DESTACADA PLUS':'PLUS DESACTIVADA')+'</span></div><div class="detail-grid"><div><small>Vendedor</small><strong>'+esc(d.sellerName||'—')+'</strong></div><div><small>Correo</small><strong>'+esc(d.sellerEmail||'—')+'</strong></div><div><small>Dirección</small><strong>'+esc(d.Address||'—')+'</strong></div><div><small>Ubicación</small><strong>'+esc((d.Latitude||'—')+', '+(d.Longitude||'—'))+'</strong></div><div><small>Horario</small><strong>'+esc(d.OpenTime||'—')+' → '+esc(d.CloseTime||'—')+'</strong></div><div><small>Automático</small><strong>'+(d.AutoSchedule==='0'?'NO':'SÍ')+'</strong></div><div><small>Delivery / Retiro</small><strong>'+esc(d.Delivery||'0')+' / '+esc(d.Pickup||'0')+'</strong></div><div><small>URL pública</small><strong>'+esc(d.PublicUrl||'—')+'</strong></div><div><small>Creada</small><strong>'+esc(d.CreatedAt||'—')+'</strong></div><div><small>Última actividad</small><strong>'+esc(d.LastActivityAt||'—')+'</strong></div></div><div class="section-title">CONTROL OPERATIVO</div><div class="action-grid"><button class="btn '+(active?'red':'yellow')+'" onclick="setActive(\''+esc(id)+'\','+(active?'false':'true')+')">'+(active?'🔴 CERRAR / BLOQUEAR':'🟡 ABRIR / HABILITAR')+'</button><button class="btn" onclick="setListed(\''+esc(id)+'\','+(listed?'false':'true')+')">'+(listed?'👁 OCULTAR DEL DIRECTORIO':'👁 PUBLICAR EN DIRECTORIO')+'</button><button class="btn yellow" onclick="setFeatured(\''+esc(id)+'\','+(featured?'false':'true')+')">'+(featured?'☆ QUITAR DESTACADA':'★ DESTACAR TIENDA')+'</button><button class="btn plus" onclick="setFeaturedPlus(\''+esc(id)+'\','+(featuredPlus?'false':'true')+')">'+(featuredPlus?'✦ QUITAR DESTACADA PLUS':'✦ DESTACADA PLUS')+'</button><button class="btn violet" onclick="setPlan(\''+esc(id)+'\')">📅 PLAN / VIGENCIA</button><button class="btn" onclick="resetPassword(\''+esc(id)+'\')">🔑 CAMBIAR CONTRASEÑA</button><button class="btn red" onclick="deleteStore(\''+esc(id)+'\')">🗑 ELIMINAR DE RAÍZ</button></div><div class="commission-box"><div class="sub">COMISIÓN DE NEXOMARKET</div><div class="commission-percent">'+Number(c.percent||1).toFixed(2)+'%</div><div class="commission-row"><div><small>VENTAS DEL MES</small><strong>$ '+Number(c.sales||0).toFixed(2)+'</strong></div><div><small>A PAGAR</small><strong class="gold">$ '+Number(c.due||0).toFixed(2)+'</strong></div><div><small>VENCIMIENTO</small><strong>'+esc(c.dueDate||'—')+'</strong></div><div><small>ESTADO</small><strong>'+(c.paid?'🟢 PAGADO':'🟡 PENDIENTE')+'</strong></div></div><div class="actions" style="margin-top:9px"><button class="btn yellow" onclick="setCommission(\''+esc(id)+'\','+Number(c.percent||1)+')">💰 CONFIGURAR PORCENTAJE</button><button class="btn green" onclick="commissionAction(\''+esc(id)+'\',\'paid\')">MARCAR PAGADO</button><button class="btn yellow" onclick="postpone(\''+esc(id)+'\')">POSTERGAR</button></div></div><div class="notice">El Super Admin controla la cuenta del vendedor y la publicación de la tienda. “Eliminar de raíz” borra la tienda, sus productos/pedidos vinculados y sus vínculos de cuenta según las rutinas centrales existentes.</div>'})}
function setActive(id,on){req('/api/admin/store/active','POST',{storeId:id,active:on?'1':'0'},function(){refresh()})}
function setListed(id,on){req('/api/admin/store/listed','POST',{storeId:id,listed:on?'1':'0'},function(){refresh()})}
function setFeatured(id,on){req('/api/admin/store/featured','POST',{storeId:id,featured:on?'1':'0'},function(t){if(t.indexOf('OK|')!==0)alert(t);refresh()})}
function setFeaturedPlus(id,on){req('/api/admin/store/featured-plus','POST',{storeId:id,featuredPlus:on?'1':'0'},function(t){if(t.indexOf('OK|')!==0)alert(t);refresh()})}
function setCommission(id,current){var p=prompt('Porcentaje de comisión para esta tienda (0 a 100):',String(current));if(p===null)return;req('/api/admin/store/commission','POST',{storeId:id,percent:p},function(t){alert(t.indexOf('OK|')===0?'Comisión actualizada.':t);refresh()})}
function setPlan(id){var permanent=confirm('¿Querés convertir esta tienda en CUENTA PERMANENTE?\n\nAceptar = Permanente\nCancelar = Cuenta por días');if(permanent){req('/api/admin/store/plan','POST',{storeId:id,plan:'permanent'},function(t){alert(t.indexOf('OK|')===0?'Cuenta permanente habilitada.':t);refresh()});return}var days=prompt('¿Cuántos días de vigencia querés asignar?','30');if(days===null)return;req('/api/admin/store/plan','POST',{storeId:id,plan:'days',days:days},function(t){alert(t.indexOf('OK|')===0?'Vigencia actualizada.':t);refresh()})}
function resetPassword(id){var p=prompt('Nueva contraseña para el vendedor (mínimo 8 caracteres):','');if(p===null)return;if(p.length<8){alert('La contraseña debe tener al menos 8 caracteres.');return}req('/api/admin/account/password','POST',{storeId:id,password:p},function(t){alert(t.indexOf('OK|')===0?'Contraseña del vendedor actualizada.':t);refresh()})}
function commissionAction(id,a){req('/api/admin/store/commission-action','POST',{storeId:id,action:a},function(t){alert(t.indexOf('OK|')===0?'Operación realizada.':t);refresh()})}
function postpone(id){var d=prompt('¿Cuántos días desde hoy querés postergar el vencimiento?','7');if(d===null)return;req('/api/admin/store/commission-action','POST',{storeId:id,action:'postpone',days:d},function(t){alert(t);refresh()})}
function deleteStore(id){var s=findStore(id);if(!s)return;if(!confirm('ELIMINAR DE RAÍZ\n\nSe eliminará '+s.name+' y sus datos vinculados.\n\n¿Continuar?'))return;if(prompt('Escribí ELIMINAR para confirmar:','')!=='ELIMINAR')return;req('/api/admin/store/delete','POST',{storeId:id},function(t){alert(t.indexOf('OK|')===0?'Tienda eliminada.':t);selectedId='';refresh()})}
function findStore(id){for(var i=0;i<stores.length;i++)if(stores[i].id===id)return stores[i];return null}
function showMenu(e,id){e=e||window.event;var m=document.getElementById('context');m.style.left=(e.clientX||0)+'px';m.style.top=(e.clientY||0)+'px';m.style.display='block';m.setAttribute('data-id',id);selectStore(id);if(e.preventDefault)e.preventDefault();return false}
function hideMenu(){document.getElementById('context').style.display='none'}
function menuAction(a){var id=document.getElementById('context').getAttribute('data-id');hideMenu();if(a==='detail')loadDetail(id);else if(a==='commission')setCommission(id,findCommission(id).percent||1);else if(a==='plan')setPlan(id);else if(a==='password')resetPassword(id);else if(a==='delete')deleteStore(id);else if(a==='active')setActive(id,!(findStore(id)||{}).active);else if(a==='featured')setFeatured(id,!(findStore(id)||{}).featured);else if(a==='plus')setFeaturedPlus(id,!(findStore(id)||{}).featuredPlus);}
function accountActive(email,on){req('/api/admin/account/active','POST',{email:email,active:on?'1':'0'},function(t){alert(t.indexOf('OK|')===0?'Cuenta actualizada.':t);refresh()})}
function accountTrial(email){var d=prompt('¿Cuántos días de vigencia querés asignar?','30');if(d===null)return;req('/api/admin/account/trial','POST',{email:email,days:d},function(t){alert(t.indexOf('OK|')===0?'Vigencia actualizada.':t);refresh()})}
function renderAccounts(){var role=document.getElementById('accountRole').value||'all',q=(document.getElementById('accountSearch').value||'').toLowerCase(),h='<table class="table"><tr><th>NOMBRE</th><th>CORREO</th><th>ROL</th><th>TIENDA</th><th>ESTADO</th><th>VIGENCIA</th><th>ACCIONES</th></tr>',n=0;for(var i=0;i<accounts.length;i++){var a=accounts[i];if(role!=='all'&&a.role!==role)continue;if(q&&(a.name+' '+a.email+' '+a.storeId).toLowerCase().indexOf(q)<0)continue;h+='<tr><td><b>'+esc(a.name)+'</b></td><td>'+esc(a.email)+'</td><td>'+esc(a.role)+'</td><td>'+esc(a.storeId)+'</td><td><span class="tag '+(a.active?'green':'red')+'">'+(a.active?'ACTIVA':'BLOQUEADA')+'</span></td><td>'+esc(a.trial||'PERMANENTE')+'</td><td><button class="btn '+(a.active?'red':'yellow')+'" onclick="accountActive(&quot;'+esc(a.email)+'&quot;,'+(a.active?'false':'true')+')">'+(a.active?'BLOQUEAR':'HABILITAR')+'</button> <button class="btn" onclick="accountTrial(&quot;'+esc(a.email)+'&quot;)">+ DÍAS</button></td></tr>';n++}h+='</table>';document.getElementById('accountTable').innerHTML=n?h:'<div class="empty">No hay cuentas en esta vista.</div>';document.getElementById('accountCount').innerHTML=n+' cuentas'}
function setView(v){view=v;document.getElementById('storesPanel').style.display=v==='stores'?'block':'none';document.getElementById('accountsPanel').style.display=v==='accounts'?'block':'none';var ns=document.querySelectorAll('.nav');for(var i=0;i<ns.length;i++)ns[i].className=ns[i].className.replace(' active','');var b=document.getElementById('nav-'+v);if(b)b.className+=' active'}
window.onclick=function(e){var t=e.target||e.srcElement;var m=document.getElementById('context');if(m&&t!==m&&t.parentNode!==m)hideMenu()};
window.onload=function(){refresh();setView('stores')};
</script>
</head>
<body oncontextmenu="return true">
<div class="top"><div class="logo"><b>NEXO</b>MARKET</div><div class="sub">SUPER ADMINISTRADOR · CONTROL CENTRAL 5.15</div><div class="spacer"></div><div id="status" class="sub">CONECTANDO...</div><button class="btn green" onclick="refresh()">↻ SINCRONIZAR</button></div>
<div class="layout"><aside class="side"><button id="nav-stores" class="btn nav active" onclick="setView('stores')">🏪 TIENDAS</button><button id="nav-accounts" class="btn nav" onclick="setView('accounts')">👥 CUENTAS</button><button class="btn nav" onclick="setView('stores');document.getElementById('storeSearch').focus()">🔎 BUSCAR TIENDA</button><button class="btn nav" onclick="setView('stores');if(selectedId)loadDetail(selectedId)">⚙ FICHA SELECCIONADA</button><div style="margin-top:25px" class="muted">Doble clic: ficha completa<br>Clic derecho: acciones<br><br>Sin MSBuild<br>Sin Visual Studio<br>Sin clave maestra</div></aside><main class="main"><div class="kpis"><div class="kpi"><small>TIENDAS</small><strong id="statStores">—</strong></div><div class="kpi"><small>CUENTAS</small><strong id="statAccounts">—</strong></div><div class="kpi"><small>TIENDAS ACTIVAS</small><strong id="statActive">—</strong></div><div class="kpi"><small>A PAGAR ESTE MES</small><strong id="statDue">$ —</strong></div><div class="kpi"><small>CONTROL</small><strong style="font-size:13px">CENTRAL</strong></div></div>
<div id="storesPanel"><div class="hero"><div><div class="sub">DIRECTORIO ADMINISTRATIVO</div><h1>Tiendas</h1><p class="muted">Seleccioná una tienda por nombre para controlar cuenta, vigencia, comisión, publicación, estado y contraseña.</p></div></div><div class="toolbar"><input id="storeSearch" placeholder="Buscar por tienda, vendedor, ciudad o rubro..." onkeyup="renderStores()"/><span id="storeCount" class="muted" style="padding:10px">0 tiendas</span></div><div class="workspace"><section class="card"><div id="storeTable"></div></section><aside id="detail" class="card detail"><div class="empty">Seleccioná una tienda.<br><br><b>Doble clic</b> o <b>clic derecho</b> para abrir su ficha.</div></aside></div></div>
<div id="accountsPanel" style="display:none"><div class="hero"><div><div class="sub">CONTROL DE CUENTAS</div><h1>Vendedores y compradores</h1><p class="muted">Vista completa separada por rol, sin salir de este panel.</p></div></div><div class="toolbar"><select id="accountRole" onchange="renderAccounts()"><option value="all">TODAS LAS CUENTAS</option><option value="seller">VENDEDORES</option><option value="buyer">COMPRADORES</option></select><input id="accountSearch" placeholder="Buscar nombre, correo o tienda..." onkeyup="renderAccounts()"/><span id="accountCount" class="muted" style="padding:10px">0 cuentas</span></div><section class="card account-table"><div id="accountTable"></div></section></div>
</main></div>
<div id="context" class="context"><button onclick="menuAction('detail')">📋 Ver ficha completa</button><button onclick="menuAction('featured')">★ Destacar tienda</button><button onclick="menuAction('plus')">✦ DESTACADA PLUS</button><button onclick="menuAction('commission')">💰 Configurar comisión</button><button onclick="menuAction('plan')">📅 Cuenta permanente / días</button><button onclick="menuAction('password')">🔑 Cambiar contraseña</button><button onclick="menuAction('active')">🟢 Abrir / 🔴 cerrar tienda</button><button onclick="menuAction('delete')">🗑 Eliminar de raíz</button></div>
</body></html>
