<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=edge" />
<meta charset="utf-8" />
<title>NexoMarket · Super Admin 5.13</title>
<HTA:APPLICATION ID="NexoMarketSuperAdmin" APPLICATIONNAME="NexoMarket Super Admin" BORDER="thin" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="maximized" />
<style>
*{box-sizing:border-box}html,body{margin:0;padding:0;background:#05070a;color:#fff;font-family:'Segoe UI',Arial,sans-serif}body{overflow:auto}.top{height:78px;background:#07090d;border-bottom:1px solid #1f2d3a;display:flex;align-items:center;padding:0 24px;gap:18px}.logo{font-size:26px;font-weight:900;letter-spacing:-1px}.logo b{color:#39ff66}.sub{color:#8fa4b7;font-size:11px;font-weight:800;letter-spacing:1px}.top .spacer{flex:1}.btn{border:1px solid #2b3e50;background:#0e1821;color:#fff;border-radius:10px;padding:10px 14px;font-weight:900;cursor:pointer}.btn:hover{border-color:#fff}.btn.green{background:#39ff66;color:#041008;border-color:#39ff66}.btn.yellow{background:#d7a51d;color:#100d03;border-color:#ffd84d}.btn.red{background:#44121a;color:#ff9baa;border-color:#8d2636}.btn.violet{background:#6f43a8;color:#fff;border-color:#a767ff}.layout{display:flex;min-height:calc(100vh - 78px)}.side{width:235px;background:#080c11;border-right:1px solid #1b2a37;padding:18px}.nav{display:block;width:100%;text-align:left;margin-bottom:8px}.nav.active{border-color:#39ff66;box-shadow:0 0 16px rgba(57,255,102,.08)}.main{flex:1;padding:22px;overflow:auto}.hero{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:22px;border:1px solid #253746;border-radius:20px;background:linear-gradient(135deg,#09131b,#0b0c14);box-shadow:0 18px 50px rgba(0,0,0,.25)}h1,h2,h3{margin-top:0}.muted{color:#91a4b5}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:16px 0}.kpi{background:#090d12;border:1px solid #1d2c39;border-radius:15px;padding:15px}.kpi small{display:block;color:#75899b;font-size:10px}.kpi strong{display:block;font-size:24px;margin-top:5px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:15px}.card{background:#090d12;border:1px solid #1e2e3c;border-radius:17px;padding:16px}.card:hover{border-color:#40576b}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:15px 0}.toolbar input,.toolbar select,.field{background:#0c141c;color:#fff;border:1px solid #294052;border-radius:10px;padding:11px}.toolbar input{min-width:260px}.store-card{display:grid;grid-template-columns:90px 1fr;gap:13px}.thumb{width:90px;height:90px;border-radius:13px;background:#111821;border:1px solid #2a4052;display:flex;align-items:center;justify-content:center;overflow:hidden;color:#39ff66;font-weight:900}.thumb img{width:100%;height:100%;object-fit:cover}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.tag{font-size:9px;border-radius:999px;padding:4px 7px;border:1px solid #334858;color:#a9bac7}.tag.green{border-color:#2b8b4a;color:#7cff9a}.tag.yellow{border-color:#9b7c27;color:#ffd84d}.tag.red{border-color:#8b2e3e;color:#ff8c9c}.tag.violet{border-color:#7547a6;color:#cba5ff}.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:10px;border-bottom:1px solid #172631;font-size:12px}.table th{color:#39ff66;font-size:10px;letter-spacing:.7px}.money{color:#ffd84d;font-weight:900}.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);align-items:center;justify-content:center;z-index:20}.modal.open{display:flex}.modal-box{width:560px;max-width:94vw;background:#090d12;border:1px solid #3a5264;border-radius:18px;padding:20px}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.field{width:100%;margin:4px 0}.empty{padding:35px;text-align:center;color:#8193a2;border:1px dashed #314654;border-radius:15px}.notice{margin-top:12px;color:#9fb1bf;font-size:12px}.danger{color:#ff8c9c}.success{color:#7cff9a}.gold{color:#ffd84d}@media(max-width:950px){.side{width:190px}.kpis{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}
</style>
<script>var BASE='https://nexomarket-0k22.onrender.com';
var stores=[],accounts=[],commissions=[],view='dashboard';
function req(path,method,data,cb){var x=null;try{x=new ActiveXObject('MSXML2.XMLHTTP.6.0')}catch(e){try{x=new ActiveXObject('Microsoft.XMLHTTP')}catch(e2){cb('',e2);return}}x.open(method||'GET',BASE+path,true);x.setRequestHeader('Content-Type','application/x-www-form-urlencoded; charset=UTF-8');x.onreadystatechange=function(){if(x.readyState===4)cb(x.responseText||'',null)};x.send(enc(data||{}));}
function enc(o){var a=[];for(var k in o)if(o.hasOwnProperty(k))a.push(encodeURIComponent(k)+'='+encodeURIComponent(o[k]==null?'':o[k]));return a.join('&')}
function json(t,def){try{return JSON.parse(t)}catch(e){return def}}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
function val(a,k){for(var i=0;i<a.length;i++){var p=a[i].split('=');if(p[0]===k)return p.slice(1).join('=')}return '0'}
function setView(v){view=v;var ns=document.querySelectorAll('.nav');for(var i=0;i<ns.length;i++)ns[i].className=ns[i].className.replace(' active','');var b=document.getElementById('nav-'+v);if(b)b.className+=' active';render()}
function refresh(){document.getElementById('status').innerHTML='● Actualizando...';req('/api/admin/overview','GET',{},function(o){req('/api/admin/stores','GET',{},function(st){req('/api/admin/accounts','GET',{},function(ac){req('/api/admin/commissions','GET',{},function(co){parseStores(st);parseAccounts(ac);commissions=json(co,[])||[];var p=o.split('|');document.getElementById('statStores').innerHTML=val(p,'stores');document.getElementById('statAccounts').innerHTML=val(p,'accounts');document.getElementById('statActive').innerHTML=val(p,'activeStores');var due=0;for(var i=0;i<commissions.length;i++)if(!commissions[i].paid)due+=Number(commissions[i].due||0);document.getElementById('statDue').innerHTML='$ '+due.toFixed(2);document.getElementById('status').innerHTML='● Central sincronizada · '+new Date().toLocaleTimeString();render();});});});});}
function parseStores(t){stores=[];var lines=(t||'').split(/\r?\n/);for(var i=0;i<lines.length;i++){var l=lines[i];if(l.indexOf('STORE|')!==0)continue;var raw=l.split('|'),p=[];for(var j=0;j<raw.length;j++){try{p.push(decodeURIComponent(raw[j]))}catch(e){p.push(raw[j])}}if(p.length>=13)stores.push({id:p[1],name:p[2],category:p[3],city:p[4],province:p[5],active:p[6]==='1',email:p[7],updated:p[8],logo:p[9],featured:p[10]==='1',listed:p[11]==='1',system:p[12]})}}
function parseAccounts(t){accounts=[];var lines=(t||'').split(/\r?\n/);for(var i=0;i<lines.length;i++){var l=lines[i];if(l.indexOf('ACCOUNT|')!==0)continue;var raw=l.split('|'),p=[];for(var j=0;j<raw.length;j++){try{p.push(decodeURIComponent(raw[j]))}catch(e){p.push(raw[j])}}if(p.length>=9)accounts.push({id:p[1],name:p[2],email:p[3],role:p[4],storeId:p[5],active:p[6]!=='0',trial:p[7],created:p[8]})}}
function q(){var e=document.getElementById('search');return (e&&e.value||'').toLowerCase()}
function render(){var m=document.getElementById('content');if(view==='dashboard')m.innerHTML=dashboard();else if(view==='stores')m.innerHTML=storesView();else if(view==='accounts')m.innerHTML=accountsView('all');else if(view==='sellers')m.innerHTML=accountsView('seller');else if(view==='buyers')m.innerHTML=accountsView('buyer');else if(view==='commissions')m.innerHTML=commissionView();else m.innerHTML=auditView()}
function dashboard(){var due=0,pending=0;for(var i=0;i<commissions.length;i++){if(!commissions[i].paid)due+=Number(commissions[i].due||0);if(!commissions[i].paid&&Number(commissions[i].due||0)>0)pending++}return '<div class="hero"><div><div class="sub">CONTROL CENTRAL</div><h1>NexoMarket Super Admin</h1><p class="muted">Control total de tiendas, vendedores, compradores, publicación y liquidaciones.</p></div><button class="btn green" onclick="refresh()">↻ ACTUALIZAR TODO</button></div><div class="grid"><div class="card"><h3>👥 Cuentas</h3><p class="muted">Separá vendedores y compradores. Activá, bloqueá y extendé pruebas.</p><div class="actions"><button class="btn" onclick="setView(\'sellers\')">VENDEDORES</button><button class="btn" onclick="setView(\'buyers\')">COMPRADORES</button></div></div><div class="card"><h3>💰 Liquidaciones</h3><p class="muted">Configurá el porcentaje por tienda y controlá lo que NexoMarket debe cobrar.</p><div class="money" style="font-size:30px">$ '+due.toFixed(2)+'</div><div class="muted">'+pending+' tiendas con saldo pendiente</div><div class="actions"><button class="btn yellow" onclick="setView(\'commissions\')">VER COMISIONES</button></div></div><div class="card"><h3>🏪 Publicación</h3><p class="muted">Una tienda puede estar activa y al mismo tiempo oculta del directorio.</p><div class="actions"><button class="btn" onclick="setView(\'stores\')">GESTIONAR TIENDAS</button></div></div><div class="card"><h3>🛡 Auditoría</h3><p class="muted">Revisá acciones administrativas y cambios importantes.</p><div class="actions"><button class="btn" onclick="setView(\'audit\');loadAudit()">VER AUDITORÍA</button></div></div></div>'}
function storesView(){var text=q(),arr=[];for(var i=0;i<stores.length;i++){var s=stores[i],hay=(s.name+' '+s.city+' '+s.email).toLowerCase();if(!text||hay.indexOf(text)>=0)arr.push(s)}var h='<div class="hero"><div><div class="sub">DIRECTORIO</div><h2>Todas las tiendas</h2><p class="muted">Activo, publicación, destacada y control operativo.</p></div></div><div class="toolbar"><input id="search" placeholder="Buscar tienda o vendedor..." value="'+esc(text)+'" onkeyup="render()"/><button class="btn" onclick="refresh()">ACTUALIZAR</button></div><div class="grid">';for(var i=0;i<arr.length;i++){var s=arr[i];h+='<div class="card store-card"><div class="thumb">'+(s.logo?'<img src="'+esc(s.logo)+'">':'N')+'</div><div><h3>'+esc(s.name)+'</h3><div class="muted">'+esc(s.category)+' · '+esc(s.city)+', '+esc(s.province)+'</div><div class="muted">'+esc(s.email)+'</div><div class="tags"><span class="tag '+(s.active?'green':'red')+'">'+(s.active?'ACTIVA':'BLOQUEADA')+'</span><span class="tag '+(s.listed?'green':'red')+'">'+(s.listed?'PUBLICADA':'OCULTA')+'</span><span class="tag '+(s.featured?'yellow':'')+'">'+(s.featured?'★ DESTACADA':'NORMAL')+'</span></div><div class="actions"><button class="btn '+(s.active?'red':'yellow')+'" onclick="toggleStore(\''+esc(s.id)+'\','+(s.active?'false':'true')+')">'+(s.active?'BLOQUEAR':'VOLVER A HABILITAR')+'</button><button class="btn" onclick="toggleListed(\''+esc(s.id)+'\','+(s.listed?'false':'true')+')">'+(s.listed?'OCULTAR':'PUBLICAR')+'</button><button class="btn yellow" onclick="toggleFeatured(\''+esc(s.id)+'\','+(s.featured?'false':'true')+')">'+(s.featured?'QUITAR DESTACADA':'★ DESTACAR')+'</button></div></div></div>'}return h+'</div>'}
function accountsView(role){var text=q(),arr=[];for(var i=0;i<accounts.length;i++){var a=accounts[i],hay=(a.name+' '+a.email).toLowerCase();if((role==='all'||a.role===role)&&(!text||hay.indexOf(text)>=0))arr.push(a)}var h='<div class="hero"><div><div class="sub">CUENTAS</div><h2>'+role.toUpperCase()+'</h2><p class="muted">'+arr.length+' cuentas.</p></div></div><div class="toolbar"><input id="search" placeholder="Buscar nombre o correo..." value="'+esc(text)+'" onkeyup="render()"/></div><div class="card"><table class="table"><tr><th>NOMBRE</th><th>CORREO</th><th>TIENDA</th><th>ESTADO</th><th>PRUEBA</th><th>ACCIONES</th></tr>';for(var i=0;i<arr.length;i++){var a=arr[i];h+='<tr><td>'+esc(a.name)+'</td><td>'+esc(a.email)+'</td><td>'+esc(a.storeId)+'</td><td><span class="tag '+(a.active?'green':'red')+'">'+(a.active?'ACTIVA':'BLOQUEADA')+'</span></td><td>'+esc(a.trial||'')+'</td><td><button class="btn '+(a.active?'red':'yellow')+'" onclick="toggleAccount(\''+esc(a.email)+'\','+(a.active?'false':'true')+')">'+(a.active?'BLOQUEAR':'VOLVER A HABILITAR')+'</button><button class="btn" onclick="trial(\''+esc(a.email)+'\')">+ DÍAS</button></td></tr>'}return h+'</table></div>'}
function commissionView(){var text=q(),arr=[];for(var i=0;i<commissions.length;i++){var c=commissions[i],hay=(c.storeName+' '+c.sellerEmail+' '+c.sellerName).toLowerCase();if(!text||hay.indexOf(text)>=0)arr.push(c)}var h='<div class="hero"><div><div class="sub">LIQUIDACIONES</div><h2>Comisiones</h2><p class="muted">Por defecto 1%. Se calcula sobre ventas válidas del mes. Podés configurar cada tienda.</p></div></div><div class="toolbar"><input id="search" placeholder="Buscar tienda o vendedor..." value="'+esc(text)+'" onkeyup="render()"/></div><div class="grid">';for(var i=0;i<arr.length;i++){var c=arr[i];h+='<div class="card"><h3>'+esc(c.storeName)+'</h3><div class="muted">'+esc(c.sellerName)+' · '+esc(c.sellerEmail)+'</div><div class="tags"><span class="tag yellow">'+esc(c.percent)+'%</span><span class="tag '+(c.paid?'green':'yellow')+'">'+(c.paid?'PAGADO':'PENDIENTE')+'</span></div><div class="row" style="margin-top:12px"><div><small class="muted">Ventas '+esc(c.month)+'</small><div class="money">$ '+Number(c.sales||0).toFixed(2)+'</div></div><div><small class="muted">A pagar</small><div class="money">$ '+Number(c.due||0).toFixed(2)+'</div></div></div><div class="notice">Vencimiento: <b>'+esc(c.dueDate)+'</b></div><div class="actions"><button class="btn violet" onclick="setPercent(\''+esc(c.storeId)+'\','+Number(c.percent||1)+')">CONFIGURAR %</button><button class="btn green" onclick="commissionAction(\''+esc(c.storeId)+'\',\'paid\')">MARCAR PAGADO</button><button class="btn yellow" onclick="postpone(\''+esc(c.storeId)+'\')">POSTERGAR</button><button class="btn '+(c.paid?'red':'red')+'" onclick="commissionAction(\''+esc(c.storeId)+'\',\'block\')">BLOQUEAR CUENTA</button><button class="btn yellow" onclick="commissionAction(\''+esc(c.storeId)+'\',\'enable\')">VOLVER A HABILITAR</button></div></div>'}return h+'</div>'}
function auditView(){return '<div class="hero"><div><div class="sub">SEGURIDAD</div><h2>Auditoría</h2><p class="muted">Últimos movimientos administrativos.</p></div><button class="btn" onclick="loadAudit()">ACTUALIZAR</button></div><div class="card" style="margin-top:15px"><pre id="audit" style="white-space:pre-wrap;color:#b9c8d4">Cargando...</pre></div>'}
function loadAudit(){req('/api/audit?limit=200','GET',{},function(t){var e=document.getElementById('audit');if(e)e.innerHTML=esc(t)})}
function toggleStore(id,on){req('/api/admin/store/active','POST',{storeId:id,active:on?'1':'0'},function(){refresh()})}
function toggleListed(id,on){req('/api/admin/store/listed','POST',{storeId:id,listed:on?'1':'0'},function(){refresh()})}
function toggleFeatured(id,on){req('/api/admin/store/featured','POST',{storeId:id,featured:on?'1':'0'},function(){refresh()})}
function toggleAccount(email,on){req('/api/admin/account/active','POST',{email:email,active:on?'1':'0'},function(){refresh()})}
function trial(email){var d=prompt('¿Cuántos días de prueba querés asignar?','30');if(d===null)return;req('/api/admin/account/trial','POST',{email:email,days:d},function(){refresh()})}
function setPercent(id,current){var p=prompt('Porcentaje de comisión para esta tienda:',String(current));if(p===null)return;req('/api/admin/store/commission','POST',{storeId:id,percent:p},function(t){alert(t.indexOf('OK|')===0?'Porcentaje actualizado.':t);refresh()})}
function commissionAction(id,a){req('/api/admin/store/commission-action','POST',{storeId:id,action:a},function(t){alert(t.indexOf('OK|')===0?'Operación realizada.':t);refresh()})}
function postpone(id){var d=prompt('¿Cuántos días desde hoy querés postergar el vencimiento?','7');if(d===null)return;req('/api/admin/store/commission-action','POST',{storeId:id,action:'postpone',days:d},function(t){alert(t);refresh()})}
window.onload=function(){refresh()};</script>
</head>
<body>
<div class="top"><div class="logo"><b>NEXO</b>MARKET</div><div class="sub">SUPER ADMINISTRADOR · CONTROL CENTRAL</div><div class="spacer"></div><div id="status" class="sub">Conectando...</div><button class="btn green" onclick="refresh()">↻ SINCRONIZAR</button></div>
<div class="layout"><aside class="side"><button id="nav-dashboard" class="btn nav active" onclick="setView('dashboard')">⌂ PANEL GENERAL</button><button id="nav-accounts" class="btn nav" onclick="setView('accounts')">👥 TODAS LAS CUENTAS</button><button id="nav-stores" class="btn nav" onclick="setView('stores')">🏪 TODAS LAS TIENDAS</button><button id="nav-sellers" class="btn nav" onclick="setView('sellers')">👤 VENDEDORES</button><button id="nav-buyers" class="btn nav" onclick="setView('buyers')">🛒 COMPRADORES</button><button id="nav-commissions" class="btn nav" onclick="setView('commissions')">💰 COMISIONES</button><button id="nav-audit" class="btn nav" onclick="setView('audit')">🛡 AUDITORÍA</button><div style="margin-top:25px" class="muted">Sin MSBuild<br>Sin Visual Studio<br>Sin clave maestra</div></aside><main class="main"><div class="kpis"><div class="kpi"><small>TIENDAS</small><strong id="statStores">—</strong></div><div class="kpi"><small>CUENTAS</small><strong id="statAccounts">—</strong></div><div class="kpi"><small>TIENDAS ACTIVAS</small><strong id="statActive">—</strong></div><div class="kpi"><small>A PAGAR ESTE MES</small><strong id="statDue">$ —</strong></div><div class="kpi"><small>ESTADO</small><strong style="font-size:14px">CENTRAL</strong></div></div><div id="content"></div></main></div>
</body></html>
